# Server-side secrets demo for products/demo/api (PHILOSOPHY "Env/config":
# secrets live in each platform's native store — Fly secrets in deploys; locally, copy
# this to products/demo/api/.env). NEVER commit a filled .env.
#
# Values below are the LOCAL stack's (ports pre-offset per product by the generator).
# The local Supabase stack has NO pooler (db.pooler disabled in supabase/config.toml),
# so BOTH URLs use the direct DB port (`db.port` in supabase/config.toml). Hosted envs
# differ per Key ruling #4 and set these as Fly secrets instead: runtime DATABASE_URL
# over the TRANSACTION-mode pooler (6543), DATABASE_MIGRATION_URL over direct 5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54422/postgres
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:postgres@localhost:54422/postgres

# Auth (Key ruling #5): JWKS is the PRIMARY verification path on ALL environments —
# point at the local Supabase stack (the current CLI issues ES256).
SUPABASE_URL=http://localhost:54421
# OPTIONAL explicit JWKS endpoint override — normally derived from SUPABASE_URL
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json); set only if an env serves JWKS
# elsewhere. Keep it COMMENTED OUT when unused: an empty `SUPABASE_JWKS_URL=` line is
# read as "" (not unset) and silently breaks the JWKS primary path -> 401s everywhere.
# SUPABASE_JWKS_URL=
# HS256 fallback ONLY (older CLI / self-hosted symmetric secret / minted test tokens).
# Same trap as above: leave COMMENTED OUT unless you have a real value — an empty
# string is treated as a configured secret.
# SUPABASE_JWT_SECRET=

# Realtime broadcast (Phase 8; service-role HTTP call). Paste the service_role key
# printed by `supabase status` (run in the product dir) — unset, broadcasts are
# skipped and clients never receive invalidations.
SUPABASE_SERVICE_ROLE_KEY=

# CORS allowlist: web origin + app:// desktop (+ mobile origins as needed).
CORS_ORIGINS=http://localhost:8081,app://-

# Rate limiting (slowapi) default bucket.
RATE_LIMIT_DEFAULT=100/minute

# Observability (Phase 8): unset SENTRY_DSN => Sentry init is a no-op. RELEASE is
# stamped by the deploy env (e.g. git SHA). Logs are structlog JSON at LOG_LEVEL.
SENTRY_DSN=
RELEASE=
LOG_LEVEL=INFO

ENVIRONMENT=local
